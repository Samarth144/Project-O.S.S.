# Public web port. The UI and API are served through the same origin.
WEB_PORT=8080

# SMTP for incident apology emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional n8n webhooks. Defaults target n8n running on the Docker host.
N8N_OBSERVER_WEBHOOK=http://host.docker.internal:5678/webhook/Observer
N8N_SCRIBE_WEBHOOK=http://host.docker.internal:5678/webhook/Scribe
N8N_SHIELD_WEBHOOK=http://host.docker.internal:5678/webhook/Shield
N8N_COMMANDER_WEBHOOK=http://host.docker.internal:5678/webhook/Commander

# Optional Supabase incident-state persistence
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
